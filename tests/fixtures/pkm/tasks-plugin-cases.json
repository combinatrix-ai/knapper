  "transport": "actual-App/official-CLI",
  "cases": [
    {
      "id": "tasks-plugin-1",
      "feature": "TASKS-QUERY",
      "query": "not done\npath includes PluginTasks/Plugin.md\nsort by due",
      "expected": {
        "type": "tasks",
        "total": 3,
        "beforeLimit": 3,
        "groups": [
          {
            "names": [],
            "tasks": [
              {
                "path": "PluginTasks/Plugin.md",
                "line": 7,
                "status": "/",
                "description": "Review notes #work",
                "markdown": "- [/] Review notes #work 🔼 📅 2026-10-03",
                "due": "2026-10-03",
                "priority": "2"
              },
              {
                "path": "PluginTasks/Plugin.md",
                "line": 4,
                "status": " ",
                "description": "Write `code` #work",
                "markdown": "- [ ] Write `code` #work ⏫ 📅 2026-10-04",
                "due": "2026-10-04",
                "priority": "1"
              },
              {
                "path": "PluginTasks/Plugin.md",
                "line": 5,
                "status": " ",
                "description": "Read notes #reading",
                "markdown": "- [ ] Read notes #reading 📅 2026-10-05",
                "due": "2026-10-05",
                "priority": "3"
              }
            ]
          }
        ]
      },
      "equal": true
    },
