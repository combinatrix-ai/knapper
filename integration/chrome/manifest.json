{
  "manifest_version": 3,
  "name": "Knapper Fill",
  "version": "0.1.0",
  "description": "Fill the focused web form control from a Knapper external reference.",
  "key": "",
  "permissions": [
    "activeTab",
    "nativeMessaging",
    "scripting",
    "storage"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "action": {
    "default_title": "Knapper Fill: choose a mode",
    "default_popup": "popup.html"
  },
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
